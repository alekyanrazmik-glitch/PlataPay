# Прокси API активации на свой домен — для страниц /redeem/.
#
# ЗАЧЕМ ЭТО НУЖНО
# Страницы /redeem/ обращаются к API поставщика прямо из браузера клиента.
# Если у поставщика закрыт CORS, браузер такой запрос заблокирует. На этот
# случай в js/pp-redeem.js есть запасной адрес — window.PP_REDEEM_API_FALLBACK,
# по умолчанию /redeem-api. Подключив этот конфиг, вы делаете запросы
# одностороннними (свой домен → свой nginx → поставщик), и вопрос CORS
# снимается совсем.
#
# Подключать обязательно только если в консоли браузера видны ошибки CORS
# при нажатии «Проверить код». Без него страницы работают, пока поставщик
# отдаёт Access-Control-Allow-Origin.
#
# ВАЖНО
#  • Проксируются ровно пять известных путей API, не всё подряд — иначе
#    получился бы открытый релей, которым воспользуется кто угодно.
#  • Cookie нашего домена в сторону поставщика не уходят.
#  • Стоит ограничение частоты: без него открытый прокси быстро найдут.
#  • Данные аккаунта клиента проходят через ваш nginx — не включайте для
#    этих путей access_log с телом запроса и не ставьте кэширование.

# В блоке http { } (обычно /etc/nginx/nginx.conf):
limit_req_zone $binary_remote_addr zone=redeemapi:10m rate=30r/m;

# В блоке server { } домена payoplata.ru:
server {
    server_name payoplata.ru www.payoplata.ru;
    # ... ваши listen/ssl_* директивы без изменений ...

    location ~ ^/redeem-api/(check|activate|service_status|claude_refresh|refresh-subscription)$ {
        limit_req zone=redeemapi burst=10 nodelay;
        limit_except GET POST { deny all; }

        rewrite ^/redeem-api/(.*)$ /api/$1 break;
        proxy_pass https://redeemgpt.com;

        proxy_http_version 1.1;
        proxy_set_header Host redeemgpt.com;
        proxy_set_header Cookie "";
        proxy_set_header Accept-Encoding "";
        proxy_ssl_server_name on;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;   # активация бывает долгой (до ~80 с)
        proxy_buffering off;

        # Ответы активации не кэшируются никогда.
        add_header Cache-Control "no-store" always;

        # X-Request-ID из ответа нужен поддержке — оставляем как есть.
        proxy_pass_header X-Request-ID;
    }
}

# Проверка после подключения:
#   curl -sS "https://payoplata.ru/redeem-api/check?cdkey=TEST" | head -c 200
#   → должен прийти JSON поставщика (скорее всего с cdk.not_found), не 404 nginx.
